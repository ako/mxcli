);

/

/**
 * A piece of information (InputText) and the corresponding embeddings vector retrieved from an Embeddings API. This is the relevant entity if you need to generate embedding vectors but do not need to store them in a knowledge base.
 */
@Position(510, 1650)
create or modify non-persistent entity GenAICommons.Chunk (
  /** The input text to create the embedding for. */
  InputText: String(unlimited),
  /** Corresponding embedding vector of the input text. */
  EmbeddingVector: String(unlimited),
  /** Internal attribute. Do not use. */
  _Index: Integer
);

/

/**
 * A collection of chunks.
 */
@Position(510, 1480)
create or modify non-persistent entity GenAICommons.ChunkCollection (
);

/

/**
 * The response returned by model contains token usage metrics.
Note: Not all connectors or models might support token usage metrics.
 */
@Position(660, 1310)
create or modify non-persistent entity GenAICommons.EmbeddingsResponse (
  /** Number of tokens in the prompt.
Note: Not all connectors or models might support token usage metrics. */
  PromptTokens: Integer,
  /** Total number of tokens used in the request.
Note: Not all connectors or models might support token usage metrics. */
  TotalTokens: Integer,
  DurationMilliseconds: Integer
);

/

/**
 * This entity represents a discrete piece of knowledge that can be used in embed and store operations. It is a specialization of Chunk and it is the relevant entity if you need to both generate embedding vectors and want to store them in a knowledge base.
 */
@Position(730, 1650)
create or modify persistent entity GenAICommons.KnowledgeBaseChunk extends GenAICommons.Chunk (
  /** This is a system-generated UUID for the chunk in the knowledge base.  */
  ChunkID: String(36),
  /** This is a front-end reference to the KnowledgeBaseChunk so that users know what it refers to (e.g. URL, document location, human-readable record ID). */
  HumanReadableID: String(4000),
  /** If the KnowledgeBaseChunk was based on a Mendix object during creation, this will contain the GUID of that object at the time of creation. */
  MxObjectID: String(200),
  /** If the KnowledgeBaseChunk was based on a Mendix object during creation, this will contain its full entity name at the time of creation. */
  MxEntity: String(4000),
  /** In case the chunk was retrieved from the knowledge base as part of a similarity search (e.g nearest neighbors retrieval) this will contain the cosine similarity to the input vector for the retrieval that was executed. */
  Similarity: Decimal
);

/

/**
 * This entity represents additional information that is to be stored with the KnowledgeBaseChunk in the knowledge base. At the time of knowledge base population, you can link as many metadata objects to a KnowledgeBaseChunk as needed. Metadata objects are key-value pairs that are used for custom filtering during the search step (retrieve). This retrieval works on an exact string-match basis for the key-value pair. Records are only retrieved if they match with all of the metadata records in the collection provided as part of the search step.
 */
@Position(730, 1980)
create or modify non-persistent entity GenAICommons.Metadata (
  /** This is the name of the metadata and typically tells how the value should be interpreted.  */
  Key: String(4000),
  /** This is the value of the metadata that provides additional information about the chunk in the context of the given key.  */
  Value: String(4000)
);

/

/**
 * An optional collection of metadata.
 */
@Position(730, 1830)
create or modify non-persistent entity GenAICommons.MetadataCollection (
);

/

