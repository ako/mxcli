-- =============================================================================
-- JSON Structure Examples
-- =============================================================================

-- MARK: Setup
create module JsonTest;

-- MARK: Show (empty)

-- List all JSON structures in the project (empty initially)
show json structures;

-- List JSON structures in a specific module
show json structures in JsonTest;

-- MARK: Create

-- Create a JSON structure from a JSON snippet (single-line)
/**
 * Simple json snippet example
 */
create json structure JsonTest.SimpleItem
folder 'json-snippets'
snippet '{"id": 1, "name": "John", "active": true}'
;

drop json structure JsonTest.SimpleItem;

/**
 * Simple json snippet example
 */
create json structure JsonTest.SimpleItem
folder 'json-snippets'
snippet '{"id": 1, "name": "John", "active": true}'
;

/**
 * Create a JSON structure in a folder
 */
create json structure JsonTest.CustomerResponse folder 'Resources' snippet $${
  "id": 1,
  "name": "John Doe",
  "email": "john@example.com",
  "active": true,
  "addresses": [
    {
      "street": "123 Main St",
      "city": "Springfield",
      "zipCode": "62701"
    }
  ],
  "tags": ["premium", "verified"]
}$$;

-- Describe a JSON structure (shows element tree + JSON snippet)
describe json structure JsonTest.CustomerResponse;

/**
 * Create with a documentation comment
 */
create json structure JsonTest.ApiError
  comment 'Standard API error response'
  snippet $${"code": 400, "message": "Bad request", "details": [{"field": "email", "error": "Invalid email format"}]}$$;

/**
 * Create with custom name mappings (matches Studio Pro's "Custom name" column)
 */
create json structure JsonTest.ExternalApi snippet $${"kvkNummer": "68750110", "vestigingsnummer": "000037178598", "naam": "Acme Corp"}$$
CUSTOM NAME map (
  'kvkNummer' as 'ChamberOfCommerceNumber',
  'vestigingsnummer' as 'BranchNumber',
  'naam' as 'CompanyName'
);

/**
 * Naming an ARRAY's item element.
 *
 * An array's item is the anonymous `[...]` entry, so it has no JSON key and the
 * plain form cannot reach it -- its name was derived (`LinesItem`) and could not
 * be changed (ako/mxcli#272). `item of` addresses it by the array's key.
 *
 * This is not cosmetic: a mapping element clones the schema element's
 * ExposedName, so the item's name is what every mapping over this structure
 * carries.
 *
 * The two clauses are independent -- naming an item does not require renaming
 * its array -- and `item of` works for a primitive array's wrapper too.
 */
create json structure JsonTest.Invoice
  snippet $${"lines": [{"sku": "A1", "qty": 2}], "tags": ["urgent"]}$$
CUSTOM NAME map (
  'lines' as 'OrderLines',
  item of 'lines' as 'OrderLine',
  item of 'tags' as 'Tag'
);

/**
 * A ROOT-level array has no key either. `item of 'Root'` names its item -- the
 * element every mapping over an array-rooted structure binds (ako/mxcli#248).
 */
create json structure JsonTest.Feed
  snippet $$[{"id": 1, "title": "t"}]$$
CUSTOM NAME map (item of 'Root' as 'Entry');

-- MARK: Describe

-- Describe a JSON structure (shows element tree + JSON snippet)
describe json structure JsonTest.CustomerResponse;

-- MARK: Modify (Idempotent — Preserves UUID)

/**
 * Update an existing JSON structure in-place.
 *
 * CREATE OR MODIFY preserves the document UUID so import/export mappings
 * that reference this structure remain valid. OR REPLACE is a synonym.
 */
create or modify json structure JsonTest.CustomerResponse snippet $${
  "id": 1,
  "name": "John Doe",
  "email": "john@example.com",
  "phone": "+1-555-0123",
  "active": true,
  "addresses": [
    {
      "street": "123 Main St",
      "city": "Springfield",
      "zipCode": "62701",
      "country": "US"
    }
  ],
  "tags": ["premium", "verified"]
}$$;

-- MARK: Drop

-- Delete JSON structures
--DROP JSON STRUCTURE JsonTest.SimpleItem;

--DROP JSON STRUCTURE JsonTest.ApiError;

--DROP JSON STRUCTURE JsonTest.ExternalApi;

--DROP JSON STRUCTURE JsonTest.CustomerResponse;
