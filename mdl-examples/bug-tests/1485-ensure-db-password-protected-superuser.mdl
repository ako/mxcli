-- ============================================================================
-- Bug test: mendixlabs/mxcli#1485 — `run --ensure-db` fails on Windows
-- PostgreSQL installs (postgres always has a password)
-- ============================================================================
--
-- Reported:
--   Error: ensuring database: no local PostgreSQL superuser available to create
--   the role/database (tried a direct 'psql -U postgres' connection over the
--   cluster socket and TCP, and non-interactive 'sudo -u postgres' ...)
--
-- The Windows installer always sets a password for `postgres` and there is no
-- sudo, so every passwordless path fails. Fixed by --db-admin-user /
-- --db-admin-password (the password reaches psql through PGPASSWORD, never
-- argv), and by an error that names them, PGPASSWORD, and the two statements
-- to run by hand. The script is incidental: the defect is in provisioning.
--
-- To verify (any PostgreSQL whose superuser needs a password; on Linux,
-- initdb -U postgres --auth=scram-sha-256 --pwfile=pw reproduces the shape):
--   mxcli run --local --ensure-db -p App.mpr
--     -> the error above, now followed by the --db-admin-* hint
--   mxcli run --local --ensure-db --db-admin-password <pw> -p App.mpr
--     -> Creating role "mendix"... Creating database ... Database ready
--   mxcli exec mdl-examples/bug-tests/1485-ensure-db-password-protected-superuser.mdl -p App.mpr
-- ============================================================================

mdl 1;

create module Bug1485;

create persistent entity Bug1485.Probe (
  "Label": String(100)
);
