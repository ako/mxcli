-- The quoting that DOES work in OQL. The refused spelling is in
-- captrack-oql-quoted-alias.fail.mdl (MDL072).
--
-- OQL takes double-quoted identifiers exactly like SQL in a SOURCE position,
-- and mxcli passes them through into the stored query unchanged. Measured at
-- 0 errors on 11.13.0. If this file ever starts failing, the advice MDL032 and
-- MDL071 both give -- "quote it in the view" -- became wrong.
--
-- The alias is the one position OQL will not take a quote in, which is why a
-- view entity's own attribute (whose name IS its alias) can never be called
-- `Month` or `Year`: that one has to be renamed, not quoted.

create persistent entity CapTrack.Sales ( Month: Integer, Amount: Integer );
/

create view entity CapTrack.SalesByMonth ( MonthNo: integer, Total: integer ) as
  select s."Month" as MonthNo, sum(s.Amount) as Total
  from CapTrack.Sales as s
  group by s."Month";
/
