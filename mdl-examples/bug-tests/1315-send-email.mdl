mdl 1;
-- ============================================================================
-- mendixlabs/mxcli#1315: MDL support for the built-in Send Email activity
-- (Microflows$SendEmailAction, Studio Pro 11.13+ beta)
-- ============================================================================
--
-- Before: no statement existed, and `describe microflow` printed the activity
-- as `-- Unsupported action: Microflows$SendEmailAction`, so a describe → exec
-- round trip deleted it. Reference model: ako/TestApp, Email.EmailMF, saved by
-- Studio Pro 11.15.0-rc.4.
--
-- Requires a Mendix 11.13+ project. Built here into a blank 11.15.0-rc.4
-- project, then `mxcli docker check`: 0 errors. Each fault mxbuild catches was
-- measured one per microflow (CE0109 unknown attachment, CE9528 non-String
-- address/host/user or non-Integer port, CE0117 non-String template parameter,
-- CE0720 placeholder without a parameter); `mxcli check` reports the type ones
-- as E009 before the build.

create module BugTest1315;

create persistent entity BugTest1315.OutboundEmail (
  Sender: String(200),
  Recipient: String(200),
  Subject: String(200),
  OrderNumber: String(20)
);
create persistent entity BugTest1315.Invoice extends System.FileDocument ();
create constant BugTest1315.SmtpHost ( Type: String, DefaultValue: 'smtp.example.com' );
create constant BugTest1315.SmtpPort ( Type: Integer, DefaultValue: 587 );
create constant BugTest1315.SmtpPassword ( Type: String, DefaultValue: '' );

-- Every clause, in the order describe prints them.
create or modify microflow BugTest1315.SUB_SendEmailSmtp (
  $Email: BugTest1315.OutboundEmail,
  $Invoice: BugTest1315.Invoice
)
returns Boolean as $Sent
begin
  send email
    from $Email/Sender
    to $Email/Recipient
    cc 'archive@example.com'
    subject 'Order {1} confirmed' with ({1} = $Email/OrderNumber)
    body text 'Your order {1} ships soon.' with ({1} = $Email/OrderNumber)
    body html '<p>Your order ships soon.</p>'
    header 'X-Correlation-Id' = 'order-confirmation'
    attachment $Invoice
    host @BugTest1315.SmtpHost port @BugTest1315.SmtpPort
    security ssl check server identity
    timeout 30000
    auth basic $Email/Sender password @BugTest1315.SmtpPassword
    on error without rollback begin
      log error node 'Mail' 'Sending failed';
      return false;
    end error;
  return true;
end;

-- The minimum: defaults are TLS, 20000 ms, no authentication. A subject that
-- is an expression is stored as the template '{1}'.
create or modify microflow BugTest1315.SUB_SendEmailMinimal ($Email: BugTest1315.OutboundEmail)
begin
  send email
    from 'noreply@example.com'
    to $Email/Recipient
    subject $Email/Subject
    host 'smtp.example.com' port 25;
end;
