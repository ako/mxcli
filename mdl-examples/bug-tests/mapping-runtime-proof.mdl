-- ============================================================================
-- Mapping constructs, proven at RUNTIME
-- ============================================================================
--
-- The nine mapping gaps closed in PR #290 were verified at the model layer and
-- with mxbuild: the BSON matched Studio Pro's, `mx check` reported 0 errors, and
-- describe -> exec round-tripped. None of that proves a mapping moves DATA.
--
-- It matters because the failure mode of a wrong mapping is silence. The inline
-- REST mapping shipped with a path of "(Object)|fields/Title" — one member whose
-- name contains a slash — and passed mxcli check, exec, mx check AND describe
-- while returning an empty column at runtime (ako/mxcli#294).
--
-- Run it:
--   mxcli run --local --test-endpoint -p <app>.mpr      # in one terminal
--   mxcli test mdl-examples/bug-tests/ -p <app>.mpr --attach
--
-- The assertions live in mapping-runtime-proof.test.mdl next door.
--
-- What this caught on its first run:
--   A mapping rooted BELOW an array yields one object per item, so the import
--   activity binds a LIST — but `mappingRootIsList` answered from the JSON
--   STRUCTURE's root (an Object here), so mxbuild rejected the activity with
--   CE0243. The mapping document was right and could not have revealed it:
--   Studio Pro's own OpenAI_API.IM_OpenAI stores MaxOccurs 1 on exactly this
--   root, so list-ness lives only in the root's PATH.
-- ============================================================================

create module RtMap;

-- ---- #248 array-rooted structure -------------------------------------------
create persistent entity RtMap.Item ( Code: String(20), Qty: Integer );
create json structure RtMap.JSON_Items snippet $$[{"code": "A", "qty": 1}]$$;
create import mapping RtMap.IMM_Items
  with json structure RtMap.JSON_Items
{ create RtMap.Item { Code = code, Qty = qty } };

create microflow RtMap.MF_Items ( $Json: string )
returns list of RtMap.Item as $List
begin
  $List = import from mapping RtMap.IMM_Items($Json);
end;
/

-- ---- #268 array of primitives (Wrapper) ------------------------------------
create persistent entity RtMap.Product ( Name: String(50) );
create persistent entity RtMap.Tag ( Value: String(50) );
create association RtMap.Tag_Product from RtMap.Tag to RtMap.Product type Reference;
create json structure RtMap.JSON_Product snippet $${"name": "n", "tags": ["a", "b"]}$$;
create import mapping RtMap.IMM_Product
  with json structure RtMap.JSON_Product
{
  create RtMap.Product {
    Name = name,
    create RtMap.Tag_Product/RtMap.Tag = tags { Value = Value }
  }
};

create microflow RtMap.MF_Product ( $Json: string )
returns RtMap.Product as $P
begin
  $P = import from mapping RtMap.IMM_Product($Json);
end;
/

-- ---- #267 mapping rooted below the payload root ----------------------------
create persistent entity RtMap.Msg ( Content: String(200) );
create json structure RtMap.JSON_Chat
  snippet $${"id": "x", "choices": [{"index": 0, "message": {"role": "a", "content": "hi"}}]}$$;
create import mapping RtMap.IMM_Chat
  with json structure RtMap.JSON_Chat root choices/message
{ create RtMap.Msg { Content = content } };

-- A root that steps THROUGH an array yields one object per item, so the
-- result is a LIST — mxbuild reports CE0243 if the activity says otherwise.
create microflow RtMap.MF_Chat ( $Json: string )
returns list of RtMap.Msg as $M
begin
  $M = import from mapping RtMap.IMM_Chat($Json);
end;
/

-- ---- #266 value converter microflow ----------------------------------------
create microflow RtMap.CONV_Upper ( $In: string )
returns String
begin
  @start(100, 200)
  @position(400, 200)
  return toUpperCase($In);
end;
/

create persistent entity RtMap.Conv ( Loud: String(50) );
create json structure RtMap.JSON_Conv snippet $${"word": "quiet"}$$;
create import mapping RtMap.IMM_Conv
  with json structure RtMap.JSON_Conv
{ create RtMap.Conv { Loud = RtMap.CONV_Upper(word) } };

create microflow RtMap.MF_Conv ( $Json: string )
returns RtMap.Conv as $C
begin
  $C = import from mapping RtMap.IMM_Conv($Json);
end;
/

-- Helpers the runtime tests assert on.
create microflow RtMap.MF_First ( $Json: string )
returns RtMap.Item as $Item
begin
  $List = import from mapping RtMap.IMM_Items($Json);
  $Item = head($List);
end;
/

create microflow RtMap.MF_Tags ( $Json: string )
returns String
begin
  $P = import from mapping RtMap.IMM_Product($Json);
  retrieve $Tags from $P/RtMap.Tag_Product;
  declare $Joined string = '';
  loop $t in $Tags
  begin
    $Joined = $Joined + '|' + $t/Value;
  end loop;
  return $P/Name + $Joined;
end;
/
