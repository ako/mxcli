-- Regression: an OQL reserved word used as a name passed every check until a
-- view entity needed it. (ako/mxcli-captrack register #1)
--
-- The reporter's exact script produced "Check passed!". By the time a view
-- needed the name, `Month`/`Year`/`Quarter` existed in 121 places across nine
-- generators and the database columns. MDL032 already reported the collision —
-- but only from inside the view's OQL, which is late.
--
-- MDL071 reports it at CREATE instead, as a WARNING. It is mild on purpose:
-- OQL takes double-quoted identifiers exactly like SQL, and mxcli writes them
-- through unchanged, so the usual fix is a quote in the view rather than a
-- rename. Measured on 11.13.0:
--
--   select s.Month   as MonthNo   ->  CE0174 "The 'Month' part is incomplete
--                                     or incorrect. You could use here:
--                                     ASTERISK, AT_SIGN, OPEN_QUOTE, or
--                                     IDENTIFIER."
--   select s."Month" as MonthNo   ->  0 errors
--   from   Module."Year" as y     ->  0 errors
--
-- The one place quoting is unavailable is an ALIAS, and that limit is OQL's:
-- it takes a bare identifier there for ANY name -- `as "Total"`, reserved
-- nowhere, is CE0174 too. A view entity's attribute name IS its select alias,
-- so a view column cannot be called Month at all; that case needs a rename.
-- See captrack-oql-quoted-alias.mdl (MDL072) for the measurement.
--
-- Run with:  mxcli check captrack-oql-reserved-names.mdl
-- Expect:    7 MDL071 warnings (+1 MDL022), 0 errors -- and `exec` writes it all.
--            Note NO MDL032: the quoted view at the bottom is clean.

-- WARNS (MDL071 x3): the reporter's verbatim case. The names are fine here --
-- the warning is about what a view will have to do with them later.
create persistent entity CapTrack."ReservedProbe" (
  "Month": Integer,
  "Year": Integer,
  "Quarter": String(10)
);
/

-- WARNS (MDL071): the ENTITY name counts too. A view says `from CapTrack.Day
-- as d`, and OQL reads `Day` there exactly as it reads an attribute after a dot
-- -- so that view must write `from CapTrack."Day" as d`.
create persistent entity CapTrack.Day ( Label: String(50) );
/

-- WARNS (MDL071): an attribute added later is held to the same rule.
alter entity CapTrack.ReservedProbe add attribute Week: Integer;
/

-- WARNS (MDL071): renaming INTO a reserved word. This is the expensive case —
-- a rename lands on a name that already has references.
alter entity CapTrack.ReservedProbe rename attribute Label to Hour;
/

-- CLEAN: renaming AWAY from a reserved word is the fix, not the problem.
alter entity CapTrack.ReservedProbe rename attribute Month to MonthNumber;
/

-- CLEAN: an AutoX pseudo-type's declared name is discarded on write, so the
-- name checked here never reaches the model. MDL022 reports the rename instead.
create persistent entity CapTrack.AutoProbe ( Day: AutoCreatedDate );
/

-- CLEAN: names that only LOOK date-shaped are not OQL keywords.
create persistent entity CapTrack.SafeProbe (
  MonthNumber: Integer,
  YearValue: Integer,
  ReportingQuarter: String(10)
);
/

-- CLEAN, and the point of the whole rule: a view CAN use a reserved name, by
-- quoting it in a source position. Both of these build at 0 errors on 11.13.0.
-- If MDL ever stops passing the quotes through, this statement is what says so.
create persistent entity CapTrack.Sales ( Month: Integer, Amount: Integer );
/
create view entity CapTrack.SalesByMonth ( MonthNo: integer, Total: integer ) as
  select s."Month" as MonthNo, sum(s.Amount) as Total
  from CapTrack.Sales as s
  group by s."Month";
/
