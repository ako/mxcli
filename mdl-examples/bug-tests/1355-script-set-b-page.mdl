-- mendixlabs/mxcli#1355 (file 2 of 2): a page whose parameter and combobox
-- datasource name entities 1355-script-set-a-domain.mdl creates. See that
-- file for the command and the before/after.

mdl 1;

create or modify page MyFirstModule.ShopOrderEdit
( Title: 'Order', Layout: Atlas_Core.Atlas_Default, Params: ( $Order: MyFirstModule.ShopOrder ) )
{
  layoutgrid lg { row { column (desktopwidth: autofill) {
    dataview dv (datasource: $Order) {
      combobox cmbCustomer (
        label: 'Customer',
        Association: MyFirstModule.ShopOrder_ShopCustomer,
        datasource: database MyFirstModule.ShopCustomer,
        CaptionAttribute: Name
      )
    }
  } } }
};
