-- upstream #935 (defect 2) — a widget inserted INTO a DataGrid2 customContent
-- cell bound its association path to nothing.
--
-- The entity-context walk in mdl/backend/pagemutator descended into a pluggable
-- widget's own widget properties but not into an object-list ITEM's — a
-- DataGrid2 column keeps its cell widgets one level deeper, at
-- Object.Properties[columns].Value.Objects[].Properties[content].Value.Widgets.
-- (#834 taught the widget FINDER that descent; this second walk never learned
-- it.) It also never read a PLUGGABLE widget's datasource, so even the grid's
-- own entity was invisible.
--
-- So `ctnCust` reported no enclosing entity, the ContentParams association path
-- could not be resolved into AttributeRef + EntityRef steps, and the raw path
-- was stored as the attribute NAME. mxcli reported success; the damage showed up
-- only later:
--
--   mx check:      [CE1613] "The selected attribute
--                  'Sample.Order_Customer/Sample.Customer_Country/CountryName'
--                  no longer exists." at Text 'txtCust2'
--   describe page: ContentParams: [{1} = Customer_Country/CountryName]
--                  (the first hop silently gone)
--
-- Measured on Mendix 10.24.20.105674: 1 error before, 0 after, with the
-- describe round-tripping the full path.
--
-- Re-runnable against any project. Run it twice: the second run must report the
-- page Replaced/Unchanged and still check at 0 errors.
--
--   mxcli exec 935-customcontent-column-entity-context.mdl -p <app>.mpr
--   mxcli docker check -p <app>.mpr
--   mxcli -p <app>.mpr -c "describe page Sample.Order_Overview"
--
-- Unit coverage: mdl/backend/pagemutator/mutator_entity_context_test.go

create or modify persistent entity Sample.Country (
  CountryName: String(200)
);

create or modify persistent entity Sample.Customer (
  Name: String(200)
);

create or modify persistent entity Sample.Order (
  OrderNo: String(50)
);

create or modify association Sample.Customer_Country from Sample.Customer to Sample.Country type reference;
create or modify association Sample.Order_Customer from Sample.Order to Sample.Customer type reference;

create or replace page Sample.Order_Overview (
  title: 'Orders',
  layout: Atlas_Core.Atlas_Default
) {
  datagrid grid1 (
    datasource: database from Sample.Order
  ) {
    column colNo (caption: 'Order', attribute: OrderNo)
    column colCust (caption: 'Customer', ShowContentAs: customContent) {
      container ctnCust {
        dynamictext txtCust (content: '{1}', contentparams: [{1} = Sample.Order_Customer/Sample.Customer_Country/CountryName])
      }
    }
  }
};

-- The regression: txtCust2 must bind the SAME two-hop path as txtCust above,
-- which CREATE PAGE has always got right. Before the fix only the inserted one
-- was broken, which is what made this look like a storage bug rather than a
-- context bug.
alter page Sample.Order_Overview {
  insert into ctnCust {
    dynamictext txtCust2 (content: '{1}', contentparams: [{1} = Sample.Order_Customer/Sample.Customer_Country/CountryName])
  }
};
