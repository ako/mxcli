-- Regression: an association whose FROM entity lives in another module wrote a
-- project that could no longer be OPENED. (ako/mxcli-captrack findings)
--
-- Before MDL070: `mxcli check` passed, `mxcli exec` printed "Created
-- association", and the next `mx check` failed while LOADING the .mpr:
--
--   KeyNotFoundException: The given key '4a25f08b-…' was not present in the
--   dictionary
--     at StreamingBsonUnitReader.ResolvePostponedProperties()
--
-- Mendix stores an association in the module of its FROM entity, so a remote
-- FROM leaves a ParentPointer aimed at an element in another unit. Neither
-- stored form can express it: Association holds two local element IDs, and
-- CrossAssociation holds a local parent plus a BY_NAME child — there is no
-- by-name PARENT. Hence a refusal, not a fix to the writer.
--
-- Run with:  mxcli check captrack-assoc-remote-parent.mdl -p app.mpr
-- Expect:    MDL070 on the two REFUSED statements, nothing on the rest.

create persistent entity MyFirstModule.Department ( Name: String(100) );

-- REFUSED (MDL070): FROM System.User, association declared in MyFirstModule.
create association MyFirstModule.User_Department
  from System.User to MyFirstModule.Department
  type reference_set owner both;
/

-- REFUSED (MDL070): not System-specific — any remote FROM module does it.
create association MyFirstModule.Account_Department
  from Administration.Account to MyFirstModule.Department
  type reference owner default;
/

-- ACCEPTED: the supported cross-module direction. The FROM entity is local, so
-- the remote end is stored BY NAME and nothing dangles. Measured at 0 errors.
create association MyFirstModule.Department_User
  from MyFirstModule.Department to System.User
  type reference owner default;
/

-- ACCEPTED: the remedy when the relationship really is many-to-many across a
-- module boundary — a join entity in your own module, one reference per side.
create persistent entity MyFirstModule.PlannerAssignment ( );
/
create association MyFirstModule.PlannerAssignment_User
  from MyFirstModule.PlannerAssignment to System.User
  type reference owner default;
/
create association MyFirstModule.PlannerAssignment_Department
  from MyFirstModule.PlannerAssignment to MyFirstModule.Department
  type reference owner default;
/
